		"infocyte",
		"security",
		"msp",
		"kaseya"
	],
	"author": {
		"name": "Tristen Rice",
		"email": "support@earneyit.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Earney-IT/n8n-nodes-datto-edr.git"
	},
	"bugs": {
		"url": "https://github.com/Earney-IT/n8n-nodes-datto-edr/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"release": "n8n-node release",
